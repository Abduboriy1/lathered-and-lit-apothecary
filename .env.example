VITE_SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
VITE_SHOPIFY_STOREFRONT_TOKEN=your-storefront-token
# Mailchimp: Audience -> Signup forms -> Embedded forms -> copy the <form action="..."> URL
VITE_MAILCHIMP_FORM_URL=https://YOUR_DC.list-manage.com/subscribe/post?u=XXXX&id=YYYY
# Meta Pixel: Events Manager -> Data sources -> your pixel -> Settings -> Pixel ID (15-16 digits)
VITE_META_PIXEL_ID=000000000000000
